# ClearSet AI — Frontend Environment Variables
# Copy to `.env` in the repo root (Vite reads it at build/dev time).
# All flags default to false: leave them unset and the UI is unchanged.

# Predictive Settlement Failure Prevention Engine
# Requires the backend flag PREDICTIVE_ENGINE_ENABLED=true as well.
VITE_PREDICTIVE_ENGINE=false

# Settlement chain visualisation (Timeline of SWIFT/depository hops)
VITE_SETTLEMENT_CHAIN_VIZ=false

# CoCo CLI investigation replay panel
VITE_COCO_CLI_REPLAY=false
