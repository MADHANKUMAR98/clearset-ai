# ==============================================================================
# CLEARSET AI - SNOWFLAKE BACKEND CONFIGURATION
# ==============================================================================

# Backend Server Port
PORT=3001

# Snowflake Account Credentials
# Account identifier format: <org>-<account> or <account_locator>.<region>
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password

# Database, Schema & Compute Context
SNOWFLAKE_DATABASE=CLEARSET_DB
SNOWFLAKE_SCHEMA=CLEARSET_SCHEMA
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN

# Programmatic Access Token (PAT) — required for Cortex Analyst REST API
# Generate in Snowsight: Admin → Users & Roles → <your user>
# → Programmatic access tokens → Generate new token
# Set role restriction to ACCOUNTADMIN and expiry to 90 days.
# The token secret is only shown once at creation time.
SNOWFLAKE_PAT=your_programmatic_access_token_here

# ==============================================================================
# SLACK INTEGRATION (optional, feature-flagged)
# ==============================================================================
# Master switch. When false, no Slack request is EVER attempted and the
# application behaves exactly as before.
SLACK_ENABLED=false

# Incoming webhook URL from your Slack workspace:
# Slack → App Directory → "Incoming WebHooks" → add to workspace → copy URL.
# Format: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX
# NEVER commit the real value — server/.env is gitignored.
SLACK_WEBHOOK_URL=

