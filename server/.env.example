# ClearSet AI — Server Environment Variables
# Copy this file to server/.env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Snowflake Connection
SNOWFLAKE_ACCOUNT=LHBBRSO-DZ87434
SNOWFLAKE_USER=MADHANKUMAR98
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_DATABASE=CLEARSET_DB
SNOWFLAKE_SCHEMA=CLEARSET_SCHEMA
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Cortex Analyst PAT (Generate in Snowsight: Admin → Users & Roles → <user> → Programmatic Access Tokens)
SNOWFLAKE_PAT=your_pat_token_here

# Optional: Slack Integration
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Optional: External Access Integration (for CoCo CLI if needed)
# EA_INTEGRATION_NAME=

# ============================================================================
# Feature flags (off by default — existing routes/behaviour unchanged)
# ============================================================================
# Enables GET /api/predict and GET /api/predict/metrics (404 when false)
PREDICTIVE_ENGINE_ENABLED=false
# Enables SETTLEMENT_CHAIN_VIZ + COCO_CLI_REPLAY (server-side, when implemented)
SETTLEMENT_CHAIN_VIZ_ENABLED=false
COCO_CLI_REPLAY_ENABLED=false